# Copy to config/.env and replace placeholders with your local settings.
# Never commit real passwords or encryption keys.
MYSQL_PROFILE=dev
DEV_DB_HOST=localhost
DEV_DB_USER=replace_me
DEV_DB_PASS=replace_me
DEV_DB_NAME=replace_me
DEV_DB_CHARSET=utf8mb4
PROD_DB_HOST=localhost
PROD_DB_USER=replace_me
PROD_DB_PASS=replace_me
PROD_DB_NAME=replace_me
PROD_DB_CHARSET=utf8mb4
SYBASE_ESPORTS_HOST=localhost
SYBASE_ESPORTS_PORT=5000
SYBASE_ESPORTS_DB=replace_me
SYBASE_ESPORTS_DSN=replace_me
SYBASE_ESPORTS_USER=replace_me
SYBASE_ESPORTS_PASS=replace_me
SYBASE_STUDENT_HOST=localhost
SYBASE_STUDENT_PORT=5000
SYBASE_STUDENT_DB=replace_me
SYBASE_STUDENT_DSN=replace_me
SYBASE_STUDENT_USER=replace_me
SYBASE_STUDENT_PASS=replace_me
SYBASE_STUDENT_PREFER_ODBC=0
SETTINGS_ENCRYPTION_KEY=replace_me

# Trusted public URL used for password reset emails (HTTPS required).
PASSWORD_RESET_BASE_URL=https://sam2026.upnm.edu.my/e-sports
